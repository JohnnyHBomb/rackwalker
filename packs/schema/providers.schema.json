{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Provider pack",
 "description": "The common providers of one country (or, with country null, the backbone names met in every country). Data only: names are facts, and there are no phone numbers, people or logos.",
 "type": "object",
 "additionalProperties": false,
 "required": ["pack", "id", "version", "country", "title", "read", "partial", "coverage", "missing", "sources", "providers"],
 "properties": {
  "pack": {"const": "providers"},
  "id": {"type": "string", "pattern": "^providers-[a-z]{2,20}$"},
  "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
  "country": {"type": ["string", "null"], "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2; null for the international pack."},
  "title": {"type": "string", "minLength": 3, "maxLength": 120},
  "read": {"$ref": "#/$defs/date", "description": "The day the pack was last checked against its sources."},
  "partial": {"type": "boolean", "description": "true: the pack is thin, and `missing` says what it lacks."},
  "coverage": {"type": "string", "minLength": 20, "maxLength": 400, "description": "What the pack is complete for and what is partial, in one or two sentences."},
  "missing": {"type": "array", "items": {"type": "string", "minLength": 3, "maxLength": 200}},
  "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
  "providers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provider"}}
 },
 "$defs": {
  "date": {"type": "string", "pattern": "^20\\d\\d-[01]\\d-[0-3]\\d$"},
  "url": {"type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 200},
  "source": {
   "type": "object",
   "additionalProperties": false,
   "required": ["name", "url", "read", "terms", "use", "result"],
   "properties": {
    "name": {"type": "string", "minLength": 3, "maxLength": 120},
    "url": {"oneOf": [{"$ref": "#/$defs/url"}, {"type": "null"}]},
    "read": {"$ref": "#/$defs/date"},
    "terms": {"type": "string", "minLength": 10, "maxLength": 400, "description": "The licence or terms of the source and what they allow, as read on `read`."},
    "use": {"enum": ["copied", "cross-check", "cited"], "description": "copied: facts taken from it; cross-check: read to confirm, nothing taken; cited: named only (its terms are unclear or forbid reuse)."},
    "result": {"type": "string", "minLength": 3, "maxLength": 300}
   }
  },
  "provider": {
   "type": "object",
   "additionalProperties": false,
   "required": ["name", "slug", "kind", "aka", "asns", "website", "support_url", "notes"],
   "properties": {
    "name": {"type": "string", "minLength": 1, "maxLength": 100, "description": "As the provider trades."},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 100},
    "kind": {"enum": ["national_carrier", "business_isp", "cable_fibre", "mobile", "wholesale", "satellite", "research_education"]},
    "aka": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 100}, "description": "Other names on a bill or a hand-off box: former names, the business brand, the group."},
    "asns": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["asn", "rir"], "properties": {
      "asn": {"type": "integer", "minimum": 1, "maximum": 4294967295},
      "rir": {"enum": ["ripe", "arin", "apnic", "lacnic", "afrinic"]}}}},
    "website": {"oneOf": [{"$ref": "#/$defs/url"}, {"type": "null"}]},
    "support_url": {"oneOf": [{"$ref": "#/$defs/url"}, {"type": "null"}], "description": "A public support or status page, only where it answered on the read date."},
    "notes": {"type": ["string", "null"], "maxLength": 200},
    "wikidata": {"type": "string", "pattern": "^Q[1-9][0-9]*$", "description": "Optional. The provider's own Wikidata item (not its parent group's), where that item states one of these AS numbers: a stable cross-reference."}
   }
  }
 }
}
