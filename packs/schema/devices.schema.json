{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Device pack",
 "description": "A set of manufacturers' device types and module types taken from one pinned commit of a device-type library. The searchable index beside it is built by packs/tools/build_device_index.py.",
 "type": "object",
 "additionalProperties": false,
 "required": ["pack", "id", "version", "title", "read", "partial", "coverage", "missing", "sources", "library", "manufacturers", "index"],
 "properties": {
  "pack": {"const": "devices"},
  "id": {"type": "string", "pattern": "^devices-[a-z0-9-]{2,40}$"},
  "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
  "title": {"type": "string", "minLength": 3, "maxLength": 120},
  "read": {"type": "string", "pattern": "^20\\d\\d-[01]\\d-[0-3]\\d$"},
  "partial": {"type": "boolean"},
  "coverage": {"type": "string", "minLength": 20, "maxLength": 400},
  "missing": {"type": "array", "items": {"type": "string", "minLength": 3, "maxLength": 200}},
  "sources": {"type": "array", "minItems": 1, "items": {"$ref": "providers.schema.json#/$defs/source"}},
  "library": {
   "type": "object",
   "additionalProperties": false,
   "required": ["repo", "commit", "commit_date", "raw_base"],
   "properties": {
    "repo": {"type": "string", "pattern": "^https://github\\.com/[^/\\s]+/[^/\\s]+$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$", "description": "The exact commit: never a branch or a tag."},
    "commit_date": {"type": "string", "pattern": "^20\\d\\d-[01]\\d-[0-3]\\d$"},
    "raw_base": {"type": "string", "pattern": "^https://raw\\.githubusercontent\\.com/[^\\s]+/[0-9a-f]{40}/$"}
   }
  },
  "manufacturers": {"oneOf": [{"const": "*"}, {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}],
                    "description": "\"*\": every manufacturer of the library; or the manufacturers' names as the library writes them."},
  "index": {
   "type": "object",
   "additionalProperties": false,
   "required": ["file", "sha256", "bytes", "manufacturers", "device_types", "module_types"],
   "properties": {
    "file": {"type": "string", "pattern": "^[a-z0-9.-]+\\.index\\.json\\.gz$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bytes": {"type": "integer", "minimum": 1},
    "manufacturers": {"type": "integer", "minimum": 1},
    "device_types": {"type": "integer", "minimum": 0},
    "module_types": {"type": "integer", "minimum": 0}
   }
  }
 }
}
